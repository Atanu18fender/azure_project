{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "atanuspotifyADF"
		},
		"azuresqlconnection_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azuresqlconnection'"
		},
		"datalakeconnection_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'datalakeconnection'"
		},
		"azuresqlconnection_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyprojectserveratanu.database.windows.net"
		},
		"azuresqlconnection_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifyprojectdb"
		},
		"azuresqlconnection_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminatanu"
		},
		"datalakeconnection_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://atanuspotifystorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "atanuspotifyADF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"azuresqlconnection_password": {
						"value": "[parameters('azuresqlconnection_password')]"
					},
					"datalakeconnection_accountKey": {
						"value": "[parameters('datalakeconnection_accountKey')]"
					},
					"azuresqlconnection_properties_typeProperties_server": {
						"value": "[parameters('azuresqlconnection_properties_typeProperties_server')]"
					},
					"azuresqlconnection_properties_typeProperties_database": {
						"value": "[parameters('azuresqlconnection_properties_typeProperties_database')]"
					},
					"azuresqlconnection_properties_typeProperties_userName": {
						"value": "[parameters('azuresqlconnection_properties_typeProperties_userName')]"
					},
					"datalakeconnection_properties_typeProperties_url": {
						"value": "[parameters('datalakeconnection_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}